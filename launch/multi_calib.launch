<launch>
  <arg name="rviz" default="false"/>
  <arg name="output_path" default="$(find fast_calib)/output/0421/front/multi"/>

  <rosparam file="$(find fast_calib)/config/ariy.yaml" command="load" subst_value="true"/>
  <param name="output_path" value="$(arg output_path)"/>

  <node pkg="fast_calib" type="multi_fast_calib" name="multi_fast_calib" output="screen">
  </node>

  <group if="$(arg rviz)">
      <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_calib)/rviz_cfg/fast_livo2.rviz" />
  </group>
launch-prefix="gdb -ex run --args"
launch-prefix="valgrind --leak-check=full"
</launch>
